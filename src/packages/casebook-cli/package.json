{
  "name": "@agents-os/casebook-cli",
  "version": "0.7.0",
  "description": "Trusted-local standalone Casebook operator CLI",
  "type": "module",
  "private": true,
  "bin": { "casebook": "bin/casebook.mjs" },
  "files": ["bin", "bridge", "lib", "schemas"],
  "scripts": { "test": "node --test test/*.test.mjs", "check": "node --check bin/casebook.mjs && node --check lib/wi033.mjs && node --check bridge/persistence-bridge.mjs" },
