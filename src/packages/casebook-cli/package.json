  "casebookCli": { "result_schema": "casebook-cli-result@2", "bridge": "bridge/persistence-bridge.mjs", "operations": ["target.describe", "case.create", "case.read", "case.commit_revision", "frame.create", "frame.read", "frame.commit_revision", "query.search", "substrate.get_receipt", "operation.recent"] }
}
