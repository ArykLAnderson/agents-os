  "implemented_slice_constraints": {
    "successor_boundary": "fresh-store-only; no predecessor probe, migration, cutover, View, semantic callback, graph/semantic/hybrid query, or standalone CLI; provider-local SQLite organizational lexical query/resolve/hydrate is the only supported global search boundary, and immutable owner placement is provided through Case and Frame provider-local adapters",
    "bootstrap": "trusted-local retained-parent identity validation, no-follow/exclusive creation, hard-link no-replace grant/store publication, and exact same-operation atomic phase-record replacement",
    "bootstrap_threat_model": "does not protect against a malicious concurrent same-UID actor able to replace trusted parent pathnames",
    "substrate": "owner-neutral immutable versions/revisions/selections with CAS, idempotency, Profile-fenced exact current/revision/family binding and projected-claim reads, receipt, event, outbox, atomic Context placement guard, integrity, and rebuild",
    "profile_admission": "one admission-slot selection; complete Namespace-free private Profile lifecycle; mandatory provider-derived profile-selection-fence@1; closed owner adapter/lifecycle/guard registration",
    "context": "durable host-neutral Namespace hierarchy with canonical name/alias path resolution, Project default, Chat binding/history, and immutable correlation claims with account_ref exactly redacted-account-ref:v1:sha256:<64 lowercase hex>; no host packaging, cwd fallback, Chat deletion, raw account/credential retention, or correlation release"
  },
